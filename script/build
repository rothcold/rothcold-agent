#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
crate=server
cargo build --manifest-path "$crate/Cargo.toml" --target-dir "$crate/target" --locked --release
mkdir -p dist
rm -f dist/*.whl
install -m755 "$crate/target/release/rothcold-agent" dist/rothcold-agent
cmp LICENSE hermes-adapter/LICENSE
install -m644 LICENSE dist/LICENSE
script/uv lock --check --offline --no-build
script/uv build --offline --wheel --no-sources --out-dir ../dist
