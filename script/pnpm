#!/bin/sh
# Run only the pinned package manager, with no ambient credentials or npm config.
set -eu
cd "$(dirname "$0")/.."
root=$(pwd)
node=$(command -v node)
[ "$("$node" -v)" = v24.13.0 ] || { echo 'Node v24.13.0 required' >&2; exit 1; }
if [ "${1:-}" = start ]; then
  [ "$#" -eq 1 ] || { echo 'start takes no arguments' >&2; exit 1; }
  cd "$root/web"
  # Production start needs only Node and the explicit, non-secret web settings.
  exec env -i PATH="$(dirname "$node"):/usr/bin:/bin" \
    ${ROTHCOLD_WEB_CONFIG+"ROTHCOLD_WEB_CONFIG=$ROTHCOLD_WEB_CONFIG"} \
    ${ROTHCOLD_WEB_ORIGIN+"ROTHCOLD_WEB_ORIGIN=$ROTHCOLD_WEB_ORIGIN"} \
    ${ROTHCOLD_WEB_PORT+"ROTHCOLD_WEB_PORT=$ROTHCOLD_WEB_PORT"} \
    "$node" server.mjs
fi
tools=$root/.tools
mkdir -p "$tools/home" "$tools/tmp"
if [ ! -f "$tools/pnpm/bin/pnpm.cjs" ]; then
  archive=$(mktemp "$tools/tmp/pnpm.XXXXXXXX")
  trap 'rm -f "$archive"' EXIT
  env -i PATH=/usr/bin:/bin curl -q --fail --silent --show-error --proto '=https' \
    https://registry.npmjs.org/pnpm/-/pnpm-10.33.0.tgz -o "$archive"
  expected='EFaLtKavtYyes2MNqQzJUWQXq+vT+rvmc58K55VyjaFJHp21pUTHatjrdXD1xLs9bGN7LLQb/c20f6gjyGSTGQ=='
  [ "$(openssl dgst -sha512 -binary "$archive" | openssl base64 -A)" = "$expected" ]
  stage=$(mktemp -d "$tools/tmp/unpack.XXXXXXXX")
  tar -xzf "$archive" -C "$stage" --no-same-owner
  mv "$stage/package" "$tools/pnpm"
  rmdir "$stage"
  rm "$archive"
fi
cd "$root/web"
path="$(dirname "$node"):/usr/bin:/bin"
if cargo=$(command -v cargo); then path="$path:$(dirname "$cargo")"; fi
exec env -i PATH="$path" HOME="$tools/home" TMPDIR="$tools/tmp" \
  CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}" \
  CI=true npm_config_userconfig=/dev/null npm_config_globalconfig=/dev/null \
  npm_config_registry=https://registry.npmjs.org/ npm_config_ignore_scripts=true \
  "$node" "$tools/pnpm/bin/pnpm.cjs" "$@"
