{
	"name": "rothcold-agent-ui",
	"private": true,
	"license": "Apache-2.0",
	"version": "0.2.0",
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": "24.13.0",
		"pnpm": "10.33.0"
	},
	"scripts": {
		"start": "node server.mjs",
		"build": "node script/check-esbuild.mjs && vite build",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint *.ts *.tsx *.mjs app.css index.html package.json tsconfig.json script",
		"format:check": "biome format *.ts *.tsx *.mjs app.css index.html package.json tsconfig.json script",
		"test": "node --test ./*.test.mjs"
	},
	"dependencies": {
		"@tiptap/core": "3.35.0",
		"@tiptap/extensions": "3.35.0",
		"@tiptap/markdown": "3.35.0",
		"@tiptap/pm": "3.35.0",
		"@tiptap/react": "3.35.0",
		"@tiptap/starter-kit": "3.35.0",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"typescript": "5.9.3",
		"vite": "7.3.8"
	}
}
